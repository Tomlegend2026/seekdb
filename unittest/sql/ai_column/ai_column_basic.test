-- AI Column basic functionality test

connection default;
--disable_warnings
drop database if exists test_ai_column_basic;
--enable_warnings
create database test_ai_column_basic;

-- Setup AI models and endpoints
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('test_complete_ep');
--error 0,11112
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('test_embed_ep');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('test_complete');
--error 0,11118
call DBMS_AI_SERVICE.DROP_AI_MODEL('test_embed');

call DBMS_AI_SERVICE.CREATE_AI_MODEL('test_complete',
  '{"type":"completion","model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL('test_embed',
  '{"type":"dense_embedding","model_name":"mock-embed"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('test_complete_ep',
  '{"ai_model_name":"test_complete","url":"http://127.0.0.1:19120/v1/chat/completions","access_key":"test-key","provider":"openai","request_model_name":"mock-complete"}');
call DBMS_AI_SERVICE.CREATE_AI_MODEL_ENDPOINT('test_embed_ep',
  '{"ai_model_name":"test_embed","url":"http://127.0.0.1:19120/v1/embeddings","access_key":"test-key","provider":"openai","request_model_name":"mock-embed"}');

-- Test 1: CREATE TABLE with AI columns
drop table if exists test_ai_column_basic.docs;
create table test_ai_column_basic.docs (
  id bigint primary key,
  content varchar(200),
  tags json AI COLUMN (
    AICOMPLETE('test_complete', concat('Classify: ', content))
  ) WITH (sync_mode='async', max_retries=2),
  emb vector(4) AI COLUMN (
    AI_EMBED('test_embed', content)
  ) WITH (sync_mode='async', max_retries=3)
);

-- Verify metadata
select count(*) = 2 as ai_metadata_rows
from oceanbase.__all_ai_column a
join oceanbase.__all_table t on t.table_id = a.table_id
join oceanbase.__all_database d on d.database_id = t.database_id
where d.database_name = 'test_ai_column_basic' and t.table_name = 'docs';

select a.column_name, a.max_retries, a.sync_mode
from oceanbase.__all_ai_column a
join oceanbase.__all_table t on t.table_id = a.table_id
join oceanbase.__all_database d on d.database_id = t.database_id
where d.database_name = 'test_ai_column_basic' and t.table_name = 'docs'
order by a.column_name;

-- Verify hidden columns
select count(*) = 6 as three_hidden_columns_per_ai_column
from oceanbase.__all_ai_column a
join oceanbase.__all_table t on t.table_id = a.table_id
join oceanbase.__all_database d on d.database_id = t.database_id
join oceanbase.__all_column c
  on c.table_id = a.table_id
 and c.column_id in (a.state_column_id, a.request_column_id,
                     a.result_spec_column_id)
where d.database_name = 'test_ai_column_basic' and t.table_name = 'docs'
  and c.is_hidden = 1;

-- Test 2: ALTER TABLE ADD AI COLUMN
drop table if exists test_ai_column_basic.alter_docs;
create table test_ai_column_basic.alter_docs(id bigint primary key, content varchar(200));
alter table test_ai_column_basic.alter_docs add column tags json AI COLUMN (
  AI_COMPLETE('test_complete', content)
) WITH (sync_mode='async', max_retries=1);

select count(*) = 1 as alter_add_metadata
from oceanbase.__all_ai_column a
join oceanbase.__all_table t on t.table_id = a.table_id
join oceanbase.__all_database d on d.database_id = t.database_id
where d.database_name = 'test_ai_column_basic' and t.table_name = 'alter_docs';

-- Test 3: Error cases
-- Dimension mismatch
--error 7600
create table test_ai_column_basic.bad_dimension(
  content varchar(20),
  emb vector(4) AI COLUMN (AI_EMBED('test_embed', content, 3))
);

-- AI-to-AI dependency
--error 1235
create table test_ai_column_basic.bad_dependency(
  content varchar(20),
  first_ai varchar(200) AI COLUMN (AI_COMPLETE('test_complete', content)),
  second_ai varchar(200) AI COLUMN (AI_COMPLETE('test_complete', first_ai))
);

-- Test 4: RETRY syntax
alter table test_ai_column_basic.docs RETRY AI COLUMN tags WHERE id = 1;

-- Cleanup
drop table test_ai_column_basic.alter_docs;
drop table test_ai_column_basic.docs;
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('test_complete_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL_ENDPOINT('test_embed_ep');
call DBMS_AI_SERVICE.DROP_AI_MODEL('test_complete');
call DBMS_AI_SERVICE.DROP_AI_MODEL('test_embed');
drop database test_ai_column_basic;
