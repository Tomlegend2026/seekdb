1
SELECT 1 FROM dual HAVING IFNULL((SELECT FALSE), !(!(1 LIKE 'x')));
1
SELECT 1 FROM dual WHERE IFNULL((SELECT FALSE), !(1 LIKE 'x'));
1
SELECT 1 FROM dual WHERE IFNULL(FALSE, !(!(1 LIKE 'x')));
1
SELECT IFNULL((SELECT FALSE), !(!(1 LIKE 'x'))) AS i1;
i1
0
SELECT IFNULL((SELECT FALSE), !(!(1 LIKE 'y'))) AS i2;
i2
0
